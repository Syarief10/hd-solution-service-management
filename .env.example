# Salin ke .env.local lalu isi. Nilai diambil dari dashboard Supabase:
# Project Settings > API (proyek hd-solution-service).
# Isi yang sama juga diatur di Vercel: Settings > Environment Variables.

# URL proyek, contoh: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Kunci publishable (sb_publishable_...) atau kunci anon lama. Aman untuk browser.
# JANGAN isi dengan kunci service_role. Aplikasi ini tidak memakainya.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional. Nomor WhatsApp toko untuk tombol "Hubungi" di halaman cek status pelanggan,
# format 62…, contoh 6281234567890. Jika kosong, tombol tidak ditampilkan.
NEXT_PUBLIC_WA_TOKO=
